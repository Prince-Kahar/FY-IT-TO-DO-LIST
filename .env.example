VITE_SUPERADMIN_PASSWORD=SuperAdmin@135!123
VITE_SUPERADMIN_EMAIL=superadmin@college.edu

# Note: Admin & Teacher credentials are now stored in the Super Admin Database (fy_it_admin_accounts).
# Super Admin can manage, create, and reset all teacher and admin passwords at /superAdmin.
